{% extends "layout.jinja" %}

{% block title %}Data Lokasi Absen{% endblock %}

{% from 'macros.jinja' import render_field, render_notif %}

{% block content %}

{{ render_notif(error, success, info) }}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">Beranda</li>
        <li class="breadcrumb-item active">Data Lokasi Absen</li>
    </ol>
</nav>

<div class="mb-3">
&nbsp;
</div>

<div class="dashboard">
    <table id="users_table" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>No.</th>
                <th>Nama Pegawai</th>
                <th>Unit</th>
                <th>Tanggal Absen</th>
                <th>Lokasi Absen Masuk</th>
                <th>Waktu Absen Masuk</th>
                <th>Lokasi Absen Pulang</th>
                <th>Waktu Absen Pulang</th>
            </tr>
        </thead>
        <tbody>
            <!-- Data will be populated here -->
        </tbody>
    </table>
</div>
{% endblock %}

{% block custom_js %}
<script>
    $(document).ready(function() {
        $('#users_table').DataTable(
            {
                "ajax": "{{ url_for('admin.get_attendances') }}",
                "columns": [
                    {"data": "no"},
                    {"data": "full_name"},
                    {"data": "division"},
                    {"data": "attendance_date"},
                    {"data": "check_in_location"},
                    {"data": "check_in"},
                    {"data": "check_out_location"},
                    {"data": "check_out"}
                ]
            }
        );
    });
</script>
{% endblock %}